{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "enabled": ["explore", "code-reviewer"],
    "default": "general",
    "custom": {
      "opencode-configure": {
        "type": "general",
        "instructions": "Configure OpenCode settings"
      }
    }
  },
  "tools": {
    "enabled": ["read", "write", "edit", "glob", "grep", "bash", "task", "websearch", "webfetch"],
    "disabled": []
  },
  "plugins": [],
  "theme": "default",
  "keybinds": {
    "ctrl+p": "quick-pick",
    "ctrl+shift+c": "copy-output"
  },
  "provider": {
    "type": "anthropic",
    "model": "claude-sonnet-4-20250514"
  },
  "permissions": {
    "skills": {
      "opencode-configure": true
    },
    "tools": {
      "bash": {
        "allowed_commands": ["ls", "cat", "git", "npm"]
      }
    }
  }
}